{
  "name": "online-school-fees-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader runner",
    "test:integration": "vitest run --config vitest.integration.config.ts --configLoader runner",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "record:demo": "node scripts/record-demo-playwright.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx src/db/scripts/check-db.ts",
    "db:verify:migrations": "tsx src/db/scripts/verify-migrations.ts",
    "auth:verify": "tsx src/db/scripts/verify-auth.ts",
    "admin:verify": "tsx src/db/scripts/verify-administration.ts",
    "students-fees:verify": "tsx src/db/scripts/verify-students-fees.ts",
    "assessments-ledger:verify": "tsx src/db/scripts/verify-assessments-ledger.ts",
    "payments-receipts:verify": "tsx src/db/scripts/verify-payments-receipts.ts",
    "portals-online:verify": "tsx src/db/scripts/verify-portals-online-payment.ts",
    "reports-reconciliation:verify": "tsx src/db/scripts/verify-reports-reconciliation.ts",
    "notifications:verify": "tsx src/db/scripts/verify-notifications.ts",
    "deadlines-announcements:verify": "tsx src/db/scripts/verify-deadlines-announcements.ts",
    "payment-submissions:verify": "tsx src/db/scripts/verify-payment-submissions.ts",
    "db:seed": "tsx src/db/scripts/seed.ts",
    "db:reset": "tsx src/db/scripts/reset-demo.ts --demo",
    "db:test:reset": "tsx src/db/scripts/reset-demo.ts --test"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@neondatabase/serverless": "^1.0.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.67.0",
    "@tanstack/react-query-devtools": "^5.67.0",
    "@tanstack/react-table": "^8.21.0",
    "better-auth": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.40.0",
    "lucide-react": "^0.479.0",
    "next": "^15.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "resend": "^4.1.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  }
}
