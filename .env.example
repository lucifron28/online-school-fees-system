# PostgreSQL Database connection string (Neon serverless or PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth configuration
BETTER_AUTH_SECRET=your-random-32-character-secret-key-here
BETTER_AUTH_API_KEY=your-better-auth-infrastructure-api-key
BETTER_AUTH_URL=http://localhost:3000

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dedicated PostgreSQL database for integration tests.
# It must not be the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/osfs_test?sslmode=require

# Destructive reset confirmations. Leave blank until you intentionally reset.
DEMO_DB_RESET_CONFIRMATION=
TEST_DB_RESET_CONFIRMATION=

# Resend API key for optional email notifications
RESEND_API_KEY=re_123456789_example_key

# Default From Email Address
EMAIL_FROM=noreply@schoolfees.example.com

# Application flags
ENABLE_STUDENT_PORTAL=true
NEXT_PUBLIC_ENABLE_DEMO_NAV=true
